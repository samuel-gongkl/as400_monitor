# AS400 / IBM i connection settings
# Copy this file to .env and fill in your values.

# Connection mode: "live" connects to the AS400, "mock" serves simulated data.
AS400_MODE=live

# ODBC driver name as registered on this machine.
# Typical name for IBM i Access Client Solutions ODBC driver:
AS400_DRIVER=IBM i Access ODBC Driver

# ---------------------------------------------------------------------------
# LPARs to monitor
# ---------------------------------------------------------------------------
# Define one numbered block per LPAR/partition. Add as many as you need
# (AS400_LPAR1_*, AS400_LPAR2_*, AS400_LPAR3_* ...). Each has its own host and
# credentials. NAME is the label shown in the UI; DRIVER and SSL are optional
# and fall back to AS400_DRIVER / AS400_SSL above.
AS400_LPAR1_NAME=HKPRD01
AS400_LPAR1_HOST=192.168.1.10
AS400_LPAR1_USER=MYUSER
AS400_LPAR1_PASSWORD=MYPASSWORD
# AS400_LPAR1_SSL=0
# AS400_LPAR1_DRIVER=IBM i Access ODBC Driver

AS400_LPAR2_NAME=HKPRD02
AS400_LPAR2_HOST=192.168.1.11
AS400_LPAR2_USER=MYUSER2
AS400_LPAR2_PASSWORD=MYPASSWORD2

AS400_LPAR3_NAME=HKDEV01
AS400_LPAR3_HOST=192.168.1.12
AS400_LPAR3_USER=MYUSER3
AS400_LPAR3_PASSWORD=MYPASSWORD3

# Single-LPAR fallback: if no AS400_LPAR1_HOST is set, these legacy variables
# are used as one LPAR (backward compatible with older setups).
# AS400_HOST=192.168.1.10
# AS400_USER=MYUSER
# AS400_PASSWORD=MYPASSWORD

# Optional default SSL for LPARs that don't override it.
AS400_SSL=0

# How often the dashboard auto-refreshes (seconds).
REFRESH_SECONDS=10

# Flask server settings.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Enable Flask debug/auto-reloader (development only). Leave off (0) normally:
# the reloader spawns a second process that would duplicate the background
# collector refresh threads.
FLASK_DEBUG=0

# ---------------------------------------------------------------------------
# Authentication (sign-on page)
# ---------------------------------------------------------------------------
# Set to 0 to disable the sign-on page entirely (not recommended). Default: on.
APP_AUTH_ENABLED=1
# Session signing key. Use a long random string (e.g. `python -c "import
# secrets; print(secrets.token_hex(32))"`). If unset, a per-run key is used and
# sessions do NOT survive a restart.
APP_SECRET_KEY=
# Sign-on username (case-insensitive). Default: admin
APP_USERNAME=admin
# Password. Prefer APP_PASSWORD_HASH (a werkzeug hash) in production; generate
# with: python -c "from werkzeug.security import generate_password_hash as g;
# print(g('YourStrongPassword'))"
APP_PASSWORD_HASH=
# Plaintext password for convenience in dev only (ignored if HASH is set). If
# neither is set, the built-in default password "admin" is used.
# APP_PASSWORD=changeme
# Session inactivity lifetime in minutes.
APP_SESSION_MINUTES=60

# LPAR CPU dashboard (/lpar): background sampler + history retention.
LPAR_SAMPLE_SECONDS=30
LPAR_HISTORY_HOURS=24
# CPU % thresholds for warning / critical highlighting on the LPAR page.
LPAR_WARN_PCT=70
LPAR_CRIT_PCT=85

# ---------------------------------------------------------------------------
# Notifications (disabled unless NOTIFY_ENABLED=1)
# ---------------------------------------------------------------------------
# The monitor sends on new alert/severity change/recovery. Set a positive
# NOTIFY_REPEAT_MINUTES if periodic reminders for ongoing alerts are wanted.
NOTIFY_ENABLED=0
NOTIFY_INTERVAL_SECONDS=60
NOTIFY_REPEAT_MINUTES=0
NOTIFY_HTTP_TIMEOUT_SECONDS=10

# Alert thresholds for notifications (independent of dashboard highlighting).
NOTIFY_CPU_WARN_PCT=75
NOTIFY_CPU_CRIT_PCT=90
NOTIFY_ASP_WARN_PCT=80
NOTIFY_ASP_CRIT_PCT=90

# SMTP email. Recipients may be comma- or semicolon-separated.
NOTIFY_EMAIL_ENABLED=0
NOTIFY_EMAIL_SMTP_HOST=smtp.example.com
NOTIFY_EMAIL_SMTP_PORT=587
NOTIFY_EMAIL_USER=monitor@example.com
NOTIFY_EMAIL_PASSWORD=CHANGE_ME
NOTIFY_EMAIL_FROM=monitor@example.com
NOTIFY_EMAIL_TO=ops@example.com
NOTIFY_EMAIL_USE_TLS=1
NOTIFY_EMAIL_USE_SSL=0

# Microsoft Teams incoming webhook / Workflows webhook URL.
# Keep this secret and never commit a real URL to source control.
NOTIFY_TEAMS_ENABLED=0
NOTIFY_TEAMS_WEBHOOK_URL=
